{
  "name": "atlas",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "db:generate": "drizzle-kit generate --config=server/db/drizzle.config.ts",
    "db:migrate": "node --env-file-if-exists=.env server/db/migrate.ts",
    "test:db": "vp test run --config=server/db/test.config.ts",
    "dev": "node --env-file-if-exists=.env node_modules/vite-plus/bin/vp dev",
    "dev:api": "node --watch --env-file-if-exists=.env server/index.ts",
    "start:api": "node --env-file-if-exists=.env server/index.ts",
    "check": "vp check",
    "format:check": "vp fmt --check",
    "lint": "vp lint",
    "typecheck": "vp check --no-fmt --no-lint",
    "test": "vp test run",
    "coverage": "vp test run --coverage",
    "test:e2e": "playwright test",
    "build": "vp build",
    "preview": "vp preview"
  },
  "dependencies": {
    "@hono/node-server": "2.1.5",
    "@workos-inc/node": "12.0.0",
    "drizzle-orm": "0.45.4",
    "hono": "4.13.14",
    "pg": "8.23.1",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@playwright/test": "1.64.1",
    "@types/node": "22.20.5",
    "@types/pg": "8.23.1",
    "@types/react": "19.2.18",
    "@types/react-dom": "19.2.7",
    "@vitejs/plugin-react": "6.1.1",
    "@vitest/coverage-v8": "5.0.5",
    "drizzle-kit": "0.31.11",
    "typescript": "6.0.2",
    "vite": "npm:@voidzero-dev/vite-plus-core@1.3.0",
    "vite-plus": "1.3.0"
  },
  "engines": {
    "node": "24.22.0"
  },
  "packageManager": "pnpm@11.23.0"
}
