# Local API only. Both pnpm dev and pnpm dev:api load .env.
# Use 3001 normally. 0 requests an ephemeral port for entrypoint tests.
API_PORT=3001

# #46/#47 will introduce and validate these when their consumers exist.
# Do not prefix server credentials with VITE_ or copy production credentials here.
# DATABASE_URL=postgresql://USER:PASSWORD@YOUR_DEV_BRANCH/atlas?sslmode=require
# WORKOS_API_KEY=replace-with-development-key
# WORKOS_CLIENT_ID=replace-with-development-client-id
# WORKOS_COOKIE_PASSWORD=replace-with-generated-secret
# WORKOS_REDIRECT_URI=http://localhost:5173/api/auth/callback
