# Local API only. Both pnpm dev and pnpm dev:api load .env.
# Use 3001 normally. 0 requests an ephemeral port for entrypoint tests.
API_PORT=3001

# Server-only database connection. Use your isolated development database.
# Migration commands change the selected database; never use staging for local tests.
# DATABASE_URL=postgresql://USER:PASSWORD@HOST/DATABASE?sslmode=verify-full

# Public application origin used for AuthKit redirects and exact Origin checks.
# Use the host you open in the browser, with no trailing slash.
# Configure APP_ORIGIN + /api/auth/callback as the redirect URI in WorkOS.
# APP_ORIGIN=http://localhost:5173

# Bearer-only API mode: set both, or omit both to deny all private requests.
# Use the environment client ID from `npx workos@latest whoami --json`
# (environment.clientId). The client ID shown under Applications can differ
# from the environment client ID and is not accepted by AuthKit.
# Copy the expected issuer from the WorkOS environment; do not derive it from the client ID.
# The default hosted AuthKit issuer is https://api.workos.com/user_management/.
# WORKOS_CLIENT_ID=client_REPLACE
# WORKOS_ISSUER=https://api.workos.com/user_management/

# Browser sign-in also needs the server API key and a random cookie password of at least 32 characters.
# Keep both values server-side. Set every WorkOS value or none.
# WORKOS_API_KEY=sk_test_REPLACE
# WORKOS_COOKIE_PASSWORD=REPLACE_WITH_AT_LEAST_32_RANDOM_CHARACTERS
