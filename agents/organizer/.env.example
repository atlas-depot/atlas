# Server-only. Evaluated through OpenRouter with synthetic notes on 2026-11-01.
OPENROUTER_API_KEY=
ORGANIZER_MODEL=anthropic/claude-sonnet-5.5
ORGANIZER_CONTEXT_TOKENS=1000000
# Idle expiry is a fallback for abandoned sessions, not an active-call deadline.
ORGANIZER_IDLE_TIMEOUT_MS=900000
# Independent random service credential, at least 32 characters. Never expose to the browser.
ORGANIZER_SERVICE_TOKEN=
# Pooled development Neon URL for the delivery registry, never VITE_*.
DATABASE_URL=
# Pin the immutable eve deployment URL when composing the Hono backend.
# Scheduled maintenance uses VERCEL_URL on Vercel if this is omitted.
ORGANIZER_RUNTIME_URL=http://127.0.0.1:2027
ORGANIZER_RESULT_RETENTION_MS=900000
# Enable only in the deployment responsible for this environment's cleanup.
ORGANIZER_MAINTENANCE_ENABLED=false
# Optional server-only access when Vercel Deployment Protection is enabled.
VERCEL_AUTOMATION_BYPASS_SECRET=
